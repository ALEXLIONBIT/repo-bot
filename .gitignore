# build output
bin/
obj/

# runtime state of the bot (state.json, logs, learned.txt, homes.txt, Brain.dll ...)
run/

# third-party binaries and the game's own assemblies: start.sh --build fetches/links them from the game folder
refs/
dl_bepinex/

# copy of the Steam config made when the launch option was set (private)
backup/

# generated by tools/dump from the game's assemblies - rerun the tool instead of committing them
tools/*_members.txt
tools/types.txt
tools/dump_err.txt
tools/dump/out/

# input daemon
tools/input/inp.fifo
tools/input/inp.log

*.tmp
