<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game is Unity/Mono, so we compile against the game's own mscorlib/netstandard
       (refs/Managed -> REPO_Data/Managed) instead of the SDK's .NET 10 reference pack. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RepoBot</AssemblyName>
    <RootNamespace>RepoBot</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/</OutputPath>
    <DebugType>none</DebugType>
    <ManagedDir>$(MSBuildThisFileDirectory)../refs/Managed/</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)*.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)../refs/BepInEx.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)../refs/0Harmony.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)../refs/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
